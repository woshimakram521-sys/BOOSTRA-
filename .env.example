# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Port (default 3000)
PORT="3000"

# Admin notification email (Recipient for all new order alerts)
ADMIN_EMAIL="mdmohammad.644633815@gmail.com"

# SMTP Email Dispatch Settings
# When configured, live emails are dispatched on new order creation, payment submission, and order status updates.
# For Gmail: Use smtp.gmail.com, Port 587, and a 16-character Google App Password (not your normal password).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-notification-sender@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_SECURE="false"
SMTP_FROM="BOOSTARA Orders <your-notification-sender@gmail.com>"

# JWT Secret for secure Admin session tokens
JWT_SECRET="boostara-super-secret-key-2026-secure-auth"
